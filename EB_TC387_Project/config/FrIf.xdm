    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="FrIf" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="FrIf" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <d:ctr type="MODULE-CONFIGURATION">
              <a:a name="DEF" value="ASPath:/AUTOSAR/EcucDefs/FrIf"/>
              <a:a name="IMPORTER_INFO" value="Unknown"/>
              <d:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" 
                     value="VariantPostBuild">
                <a:a name="IMPORTER_INFO" value="Unknown"/>
              </d:var>
              <d:ctr name="FrIfConfig" type="IDENTIFIABLE">
                <d:lst name="FrIfMaxPduCnt"/>
                <!-- Two independent channel-A clusters, 5 ms cycle, 50 static slots, 64-byte payloads.
                     A-net: RX11/12/13 LPDU0/1/2, TX17/42/50 LPDU3/4/5; no Startup/Sync.
                     B-net: Startup+Sync4 LPDU0, TX11/12/13 LPDU1/2/3, RX17/42/50 LPDU4/5/6.
                     FrIf is generation metadata only; unified application service owns MCAL at runtime. -->
                <d:lst name="FrIfCluster" type="MAP">
                  <d:ctr name="FrIfCluster_0" type="IDENTIFIABLE">
                    <d:var name="FrIfClstIdx" type="INTEGER" value="0"/>
                    <d:var name="FrIfMainFunctionPeriod" type="FLOAT" 
                           value="0.0"/>
                    <d:var name="FrIfGChannels" type="ENUMERATION" 
                           value="FR_CHANNEL_A"/>
                    <d:var name="FrIfGColdStartAttempts" type="INTEGER" 
                           value="31"/>
                    <d:var name="FrIfGListenNoise" type="INTEGER" value="16"/>
                    <d:var name="FrIfGMacroPerCycle" type="INTEGER" value="4900"/>
                    <d:var name="FrIfGMaxWithoutClockCorrectFatal" 
                           type="INTEGER" value="1"/>
                    <d:var name="FrIfGMaxWithoutClockCorrectPassive" 
                           type="INTEGER" value="1"/>
                    <d:var name="FrIfGNumberOfMinislots" type="INTEGER"
                           value="200"/>
                    <d:var name="FrIfGNumberOfStaticSlots" type="INTEGER" 
                           value="38"/>
                    <d:var name="FrIfGPayloadLengthStatic" type="INTEGER"
                           value="32"/>
                    <d:var name="FrIfGdActionPointOffset" type="INTEGER" 
                           value="8"/>
                    <d:var name="FrIfGdCasRxLowMax" type="INTEGER" value="89"/>
                    <d:var name="FrIfGdCycle" type="FLOAT" value="0.0049"/>
                    <d:var name="FrIfGdDynamicSlotIdlePhase" type="INTEGER" 
                           value="1"/>
                    <d:var name="FrIfGdMacrotick" type="FLOAT" value="1.0E-6"/>
                    <d:var name="FrIfGdMiniSlotActionPointOffset" 
                           type="INTEGER" value="3"/>
                    <d:var name="FrIfGdMinislot" type="INTEGER" value="6"/>
                    <d:var name="FrIfGdNit" type="INTEGER" value="199"/>
                    <d:var name="FrIfGdSampleClockPeriod" type="ENUMERATION" 
                           value="T12_5NS"/>
                    <d:var name="FrIfGdStaticSlot" type="INTEGER" value="92"/>
                    <d:var name="FrIfGdSymbolWindow" type="INTEGER" value="0"/>
                    <d:lst name="FrIfController" type="MAP">
                      <d:ctr name="FrIfController_0" type="IDENTIFIABLE">
                        <d:var name="FrIfCtrlIdx" type="INTEGER" value="0"/>
                        <d:ref name="FrIfFrCtrlRef" type="REFERENCE" 
